# ── Application ──────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=SolarScope API
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Kolkata

# ── MongoDB ───────────────────────────────────────────────────────────
# Local development:
MONGODB_URI=mongodb://localhost:27017
# Docker Compose:
# MONGODB_URI=mongodb://mongo:27017
# Atlas production:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DATABASE=solarscope

# ── Security (CHANGE IN PRODUCTION — min 64 characters) ──────────────
JWT_SECRET=CHANGE_ME_use_a_long_random_secret_string_at_least_64_chars_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────
# Local development:
CORS_ORIGINS=["http://localhost:3000"]
# Production:
# CORS_ORIGINS=["https://yourdomain.com"]

# ── File uploads ──────────────────────────────────────────────────────
UPLOAD_MAX_MB=50
UPLOAD_DIR=/tmp/solarscope_uploads

# ── Storage (optional — leave blank for local file storage) ───────────
STORAGE_BUCKET=
